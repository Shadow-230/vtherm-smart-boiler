# Copy to devenv/local.env (git-ignored) and fill in. Only this host is ever contacted.
TEST_HA_HOST=
TEST_HA_SSH_USER=
TEST_HA_DIR=/opt/ha-test
TEST_HA_URL=http://TEST_HA_HOST:8123
TEST_HA_TOKEN=
TZ=UTC
# More test instances in the same LXC, optional (scripts/deploy_test.sh --instance N, N = 2-8):
# each with a directory of its own holding the marker file; Home Assistant on port 8122 + N.
TEST_HA_DIR_2=/opt/ha-test-2
TEST_HA_URL_2=http://TEST_HA_HOST:8124
TEST_HA_TOKEN_2=
